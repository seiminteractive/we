# Copiá este archivo a .env.local y completá con los datos del proyecto Firebase.
# Consola: https://console.firebase.google.com/project/wecc-3717b/settings/general
# Ojo: estos valores son configuracion publica de cliente, no son secretos.
# La seguridad real vive en firestore.rules y storage.rules.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Mail habilitado para entrar al panel /admin
VITE_ADMIN_EMAIL=admin@wecc.io
